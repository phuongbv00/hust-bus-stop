@startuml
start
:Receive notification request
(event/userIds, title, body, data);
:Validate audience & content;

:Resolve recipients -> devices;
if (Any device tokens?) then (yes)
  :Build platform-specific payloads;
  fork
    :Send to FCM (Android/Web);
  fork again
    :Send to APNS (iOS);
  end fork
  :Update delivery logs;
  :Deactivate invalid tokens;
else (no)
  :No-op (no devices);
endif

if (Retry needed?) then (yes)
  :Schedule exponential backoff;
endif
stop
@enduml