@startuml
'title updated to reflect K8s-based deployment aligned with component architecture
Title Deployment Diagram - Kubernetes Architecture

left to right direction

' Client devices
node "Sinh viên Device" {
  artifact "Mobile App (Student)" as AppStudent
}
node "Tài xế Device" {
  artifact "Mobile App (Driver)" as AppDriver
}
node "Admin Workstation" {
  artifact "Web Browser (Admin Dashboard)" as Browser
}

cloud "Internet / CDN" as CDN

node "DMZ" {
  node "K8s Ingress Controller\n(+ API Gateway)" as Ingress
}

node "Kubernetes Cluster" as K8s {
  frame "Namespace: gateway" as ns_gw {
    component "API Gateway\n(Deployment/Service)" as APIGW
  }

  frame "Namespace: app" as ns_app {
    node "Auth Service\n(Deployment + ClusterIP Service)" as Auth
    node "User & Enrollment Service\n(Deployment + ClusterIP Service)" as UserSvc
    node "Trip & Route Service\n(Deployment + ClusterIP Service)" as TripSvc
    node "Notification Service\n(Deployment + ClusterIP Service)" as NotifSvc
    node "GPS Ingestion & Realtime Service\n(Deployment + ClusterIP Service)" as GPSSvc
    node "Analytics & Reporting Service\n(Deployment + ClusterIP Service)" as AnalyticsSvc
  }

  frame "Namespace: data" as ns_data {
    queue "Kafka\n(StatefulSet)" as Kafka
    database "PostgreSQL\n(StatefulSet/Managed)" as DB
    node "Object Storage (MinIO/S3)\n(StatefulSet/External)" as S3
  }

  frame "Namespace: spark" as ns_spark {
    node "Spark Cluster" as SparkCluster {
      node "Spark Master" as SparkMaster
      node "Spark Worker 1" as SparkW1
      node "Spark Worker 2" as SparkW2
      node "Spark Worker 3" as SparkW3
    }
    component "Spark Connect\n(Client)" as SparkConnect
  }

  ' Spark internal wiring
  SparkConnect --> SparkMaster
  SparkMaster --> SparkW1
  SparkMaster --> SparkW2
  SparkMaster --> SparkW3
}

package "External Services" {
  node "IdP (Google/Azure)" as IdP
  node "APNS/FCM" as Push
  node "Map/Traffic API" as MapAPI
}

' Client connections via CDN -> Ingress -> Gateway
AppStudent --> CDN
AppDriver --> CDN
Browser --> CDN
CDN --> Ingress
Ingress --> APIGW

' Gateway routes to internal microservices (simplified via namespace)
APIGW --> ns_app

' Service-to-data interactions (simplified via namespace)
ns_app --> ns_data
ns_spark --> ns_data

' External integrations (simplified via namespace)
ns_app --> "External Services"



@enduml