@startuml
skinparam classAttributeIconSize 0

class User {
  +uuid id
  +string name
  +string email
  +string role  // STUDENT, ADMIN, DRIVER
}

class Student {
  +string code
  +string phone
}

class Driver {
  +string licenseNumber
  +string phone
}

class Vehicle {
  +uuid id
  +string plateNumber
  +int seats
  +string status
}

class Enrollment {
  +uuid id
  +string status // ACTIVE, PAUSED, CANCELED, PENDING
  +string pickupAddress
  +decimal lat
  +decimal lon
}

class Stop {
  +uuid id
  +string name
  +decimal lat
  +decimal lon
}

class Route {
  +uuid id
  +string name
}

class RouteStop {
  +int sequence
  +datetime etaPlanned
}

class Trip {
  +uuid id
  +datetime startTime
  +datetime endTime
  +string status // PLANNED, STARTED, ARRIVED, FINISHED, CANCELED
}

class CheckIn {
  +uuid id
  +datetime time
  +string method // QR, OFFLINE_SYNC
}

class GPSLocation {
  +uuid id
  +decimal lat
  +decimal lon
  +datetime time
  +uuid tripId
}

class Notification {
  +uuid id
  +string type // REMINDER, NEARBY, EMERGENCY
  +string content
  +datetime time
}

class Feedback {
  +uuid id
  +string title
  +string content
  +string status // NEW, IN_PROGRESS, RESOLVED
}

Student --|> User
Admin --|> User
Driver --|> User

Student "1" *-- "*" Enrollment
Enrollment "1..*" -- "0..1" Stop

Route "1" *-- "1..*" RouteStop
RouteStop "0..*" --* "1" Stop

Route "1" -- "0..*" Trip
Trip "1" *-- "0..*" GPSLocation: > record
Trip "1" -- "0..*" CheckIn

Driver "0..1" -- "0..*" Trip: > assigned
Vehicle "0..1" -- "0..*" Trip: > assigned

Student "1" -- "0..*" CheckIn
User "1" -- "0..*" Notification: > receive

Admin "1" -- "0..*" Notification: > publish

Feedback "0..*" -- "1" Student: < submit
Feedback "0..*" -- "1" Admin: < handle

@enduml