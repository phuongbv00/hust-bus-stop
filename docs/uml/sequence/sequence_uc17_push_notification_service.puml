@startuml
participant "Event Producer (Any UC)" as Producer
participant "Notification Service" as Notif
database "DB" as DB
participant "APNS/FCM" as Push
participant "Client Devices" as Devices

Producer -> Notif : send(userIds, title, body, data)
Notif -> DB : lookup devices by users
DB --> Notif : device tokens
Notif -> Push : send to APNS/FCM
Push --> Devices : deliver notification
@enduml